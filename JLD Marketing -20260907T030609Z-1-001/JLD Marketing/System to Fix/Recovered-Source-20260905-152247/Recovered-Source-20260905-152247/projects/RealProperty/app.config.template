<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Copy this file to app.config, then replace only the placeholder values. Do not use a MySQL root account. -->
    <add name="ConStr"
         providerName="MySql.Data.MySqlClient"
         connectionString="Server=localhost;Port=3306;Database=realtydb;Uid=realproperty_app;Pwd=REPLACE_WITH_SECRET;Convert Zero Datetime=True;Connection Timeout=5;Default Command Timeout=30;" />
  </connectionStrings>
</configuration>
